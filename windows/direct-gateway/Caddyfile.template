# This file is generated by Configure-DirectGateway.ps1. Do not put secrets here.
{
    admin off
}

{{DOMAIN}} {
    # Caddy obtains and renews a public ACME certificate automatically.
    # WebSocket Upgrade is proxied automatically by reverse_proxy.
    reverse_proxy 127.0.0.1:8765 {
        transport http {
            versions 1.1
        }
    }
    header -Server
}
